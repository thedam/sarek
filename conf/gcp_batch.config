/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Prototype config for running sarek joint genotyping at scale on GCP Batch
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    ~1000 WGS samples, CRAM 20-30 GB/sample, gVCF ~5 GB/sample, GCS storage,
    GCP Batch compute on preemptible (spot) VMs.

    NOTE: this is a prototype intended for review, not a cloud-tested config.
    Fill in <PROJECT>, <REGION>, <BUCKET> and the service-account details before use.

    Run:
        nextflow run . -profile gcp_batch \
            --step variant_calling --tools deepvariant,vep --joint_genotype \
            --input gs://<BUCKET>/cohort/samplesheet.csv \
            --outdir gs://<BUCKET>/results \
            -work-dir gs://<BUCKET>/work

    See docs/joint_genotyping_at_scale.md for the rationale behind these settings.
----------------------------------------------------------------------------------------
*/

plugins {
    id 'nf-google'
}

params {
    // Keep large intermediates in the cloud; GLnexus reads gVCFs straight from GCS.
    igenomes_ignore = true
}

process {
    executor = 'google-batch'

    // Retry transient failures. Spot *preemptions* are handled separately by
    // google.batch.maxSpotAttempts (below) and do not consume these attempts.
    // Sharded, idempotent tasks make any retry cheap.
    errorStrategy = { task.attempt <= 3 ? 'retry' : 'finish' }
    maxRetries    = 3
    maxErrors     = '-1'   // a handful of bad tasks must not abort a 1000-sample run
}

google {
    project  = '<PROJECT>'
    location = '<REGION>'              // e.g. 'europe-west4' — keep in the GCS bucket's region

    batch {
        spot            = true         // preemptible VMs (~60-91% cheaper)
        maxSpotAttempts = 5            // re-run preempted tasks on a fresh spot VM (separate from maxRetries)
        bootDiskSize    = '50.GB'
        // Co-locate compute with the bucket region to avoid egress and cut localization
        // latency for the ~5 TB of cohort gVCFs.
        // serviceAccountEmail = 'sarek-batch@<PROJECT>.iam.gserviceaccount.com'
    }
}

// Stage inputs/outputs/work through GCS; no control node ever holds the TB-scale data.
workDir = 'gs://<BUCKET>/work'

process {
    // ---- DeepVariant (per sample, embarrassingly parallel) -------------------
    withName: 'DEEPVARIANT_RUNDEEPVARIANT' {
        cpus   = 32
        memory = '64.GB'
        disk   = '200.GB'              // one localized CRAM + scratch
        time   = '8.h'
    }

    // ---- GLnexus (cohort joint genotyping, memory + local-disk bound) ---------
    // GLnexus builds a RocksDB on local disk and holds working state in RAM; both scale
    // with (#samples x region size). Give it a high-mem VM and a fast LOCAL SSD scratch
    // (a network persistent disk would bottleneck the DB). Shard by region to bound peak
    // memory; small shards also make a spot reclaim cheap to re-run -- the long gather is
    // the most painful task to lose. For a guaranteed-completion gather, run this process
    // on a non-spot queue instead (see docs/joint_genotyping_at_scale.md).
    withName: '.*:BAM_JOINT_GENOTYPING_DEEPVARIANT:GLNEXUS' {
        cpus    = 32
        memory  = '208.GB'                                  // n2-highmem-32 class; raise for whole-genome shards
        disk    = [request: '1500.GB', type: 'local-ssd']   // 4 x 375 GB local SSD for the RocksDB scratch
        scratch = true
        time    = '24.h'
    }

    withName: '.*:BAM_JOINT_GENOTYPING_DEEPVARIANT:BCFTOOLS_VIEW_JOINT' {
        cpus   = 8
        memory = '16.GB'
        disk   = '200.GB'
    }
}
