/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for testing DeepVariant joint genotyping
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Minimal test of the DeepVariant + GLnexus cohort joint-genotyping path.
    Runs DeepVariant on 3 germline samples, merges the gVCFs with GLnexus and
    emits a single multi-sample VCF.

    Use as follows:
        nextflow run nf-core/sarek -profile test_joint_genotype,docker --outdir <OUTDIR>

    To additionally produce a VEP-annotated cohort VCF, append `vep` to the tools
    and provide a cache, e.g.:
        nextflow run nf-core/sarek -profile test_joint_genotype,docker --outdir <OUTDIR> \
            --tools deepvariant,vep --download_cache --vep_cache_version 110 --vep_genome <genome>
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// Reuse the small test reference genome and resource limits from the base test profile.
includeConfig 'test.config'

params {
    config_profile_name        = 'DeepVariant joint genotyping test profile'
    config_profile_description = 'Minimal test of DeepVariant + GLnexus cohort joint genotyping'

    // Three germline samples already mapped to the small test genome
    input          = "${projectDir}/tests/csv/3.0/joint_genotype_cram.csv"
    step           = 'variant_calling'

    // DeepVariant per-sample calling followed by GLnexus joint genotyping
    tools          = 'deepvariant'
    joint_genotype = true

    // Skip the vcftools TsTv QC: vcftools 0.1.16 aborts (SIGABRT) on the minimal
    // 3-variant multi-sample test VCF. This QC is unrelated to joint genotyping and
    // works on real-sized cohorts; skipping keeps the minimal test green.
    skip_tools     = 'vcftools'
}
