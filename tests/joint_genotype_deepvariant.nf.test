def projectDir = new File('.').absolutePath

nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"

    def test_scenario = [
        [
            name: "-profile test --tools deepvariant --joint_genotype --input tests/csv/3.0/joint_genotype_cram.csv",
            params: [
                input: "${projectDir}/tests/csv/3.0/joint_genotype_cram.csv",
                step: "variant_calling",
                tools: 'deepvariant',
                joint_genotype: true
            ],
            no_conda: true
        ],
        [
            name: "-profile test --tools deepvariant --joint_genotype --input tests/csv/3.0/joint_genotype_cram.csv -stub",
            params: [
                input: "${projectDir}/tests/csv/3.0/joint_genotype_cram.csv",
                step: "variant_calling",
                tools: 'deepvariant',
                joint_genotype: true
            ],
            no_conda: true,
            stub: true
        ]
    ]

    test_scenario.each { scenario ->
        test(scenario.name, UTILS.getTest(scenario))
    }
}
